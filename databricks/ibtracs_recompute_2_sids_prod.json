{
  "run_name": "[ops] IBTrACS buffers + exposure recompute for 2 SIDs (prod, PR #64 step 5)",
  "git_source": {
    "git_url": "https://github.com/OCHA-DAP/ds-storms-pipeline.git",
    "git_provider": "gitHub",
    "git_branch": "ops/ibtracs-recompute-2-sids"
  },
  "tasks": [
    {
      "task_key": "recompute",
      "spark_python_task": {
        "python_file": "databricks/run_ibtracs_sids.py",
        "source": "GIT",
        "parameters": [
          "--mode",
          "prod",
          "--sids",
          "2025274N16087",
          "2026254N11252"
        ]
      },
      "new_cluster": {
        "policy_id": "0017962FF5D1E3B9",
        "apply_policy_default_values": true,
        "spark_version": "18.2.x-scala2.13",
        "node_type_id": "Standard_DS4_v2",
        "num_workers": 0,
        "data_security_mode": "SINGLE_USER"
      },
      "libraries": [
        {
          "pypi": {
            "package": "ocha-stratus"
          }
        },
        {
          "pypi": {
            "package": "ocha-lens==0.6.2"
          }
        },
        {
          "pypi": {
            "package": "python-dotenv"
          }
        },
        {
          "pypi": {
            "package": "geopandas"
          }
        },
        {
          "pypi": {
            "package": "rasterio"
          }
        },
        {
          "pypi": {
            "package": "rioxarray"
          }
        },
        {
          "pypi": {
            "package": "exactextract"
          }
        },
        {
          "pypi": {
            "package": "antimeridian"
          }
        },
        {
          "pypi": {
            "package": "coloredlogs"
          }
        },
        {
          "pypi": {
            "package": "tqdm"
          }
        },
        {
          "pypi": {
            "package": "geoalchemy2"
          }
        }
      ],
      "timeout_seconds": 5400
    }
  ],
  "run_as": {
    "user_name": "adm.tdowning@global.un.org"
  },
  "email_notifications": {
    "on_failure": [
      "tristan.downing@un.org"
    ]
  }
}
