{
  "run_name": "[ops] MFR CXML forecast archive 2010/11-2023/24 backfill (dev)",
  "git_source": {
    "git_url": "https://github.com/OCHA-DAP/ds-storms-pipeline.git",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "tasks": [
    {
      "task_key": "backfill_cxml",
      "spark_python_task": {
        "python_file": "databricks/run_mfr.py",
        "source": "GIT",
        "parameters": [
          "backfill",
          "--blob-prefix",
          "ds-storms-pipeline/raw/mfr/backfill_staging/cxml_20102011_20232024/",
          "--blob-stage",
          "dev",
          "--container",
          "projects",
          "--mode",
          "dev"
        ]
      },
      "new_cluster": {
        "policy_id": "0017962FF5D1E3B9",
        "apply_policy_default_values": true,
        "spark_version": "18.2.x-scala2.13",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 0,
        "data_security_mode": "SINGLE_USER"
      },
      "libraries": [
        {
          "pypi": {
            "package": "ocha-stratus==0.1.7"
          }
        },
        {
          "pypi": {
            "package": "python-dotenv"
          }
        }
      ],
      "timeout_seconds": 7200
    }
  ],
  "run_as": {
    "user_name": "adm.tdowning@global.un.org"
  },
  "email_notifications": {
    "on_failure": [
      "tristan.downing@un.org"
    ]
  }
}
