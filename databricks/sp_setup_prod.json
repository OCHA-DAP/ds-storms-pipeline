{
  "run_name": "[ops] South Pacific tables + history + FMS archive (prod)",
  "git_source": {
    "git_url": "https://github.com/OCHA-DAP/ds-storms-pipeline.git",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "job_clusters": [
    {
      "job_cluster_key": "sp_setup",
      "new_cluster": {
        "policy_id": "0017962FF5D1E3B9",
        "apply_policy_default_values": true,
        "spark_version": "18.2.x-scala2.13",
        "node_type_id": "Standard_DS4_v2",
        "num_workers": 0,
        "data_security_mode": "SINGLE_USER"
      }
    }
  ],
  "tasks": [
    {
      "task_key": "init_db",
      "spark_python_task": {
        "python_file": "scripts/init_db_sp.py",
        "source": "GIT",
        "parameters": [
          "--mode",
          "prod"
        ]
      },
      "job_cluster_key": "sp_setup",
      "libraries": [
        {
          "pypi": {
            "package": "ocha-stratus"
          }
        },
        {
          "pypi": {
            "package": "ocha-lens==0.7.0"
          }
        },
        {
          "pypi": {
            "package": "python-dotenv"
          }
        },
        {
          "pypi": {
            "package": "geopandas"
          }
        },
        {
          "pypi": {
            "package": "rasterio"
          }
        },
        {
          "pypi": {
            "package": "rioxarray"
          }
        },
        {
          "pypi": {
            "package": "exactextract"
          }
        },
        {
          "pypi": {
            "package": "antimeridian"
          }
        },
        {
          "pypi": {
            "package": "coloredlogs"
          }
        },
        {
          "pypi": {
            "package": "tqdm"
          }
        },
        {
          "pypi": {
            "package": "geoalchemy2"
          }
        },
        {
          "pypi": {
            "package": "netCDF4"
          }
        }
      ],
      "timeout_seconds": 1800
    },
    {
